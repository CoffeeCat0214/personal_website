# Buttondown username for the subscribe form on the Subscribe act.
#
# Unset, Subscribe.tsx renders nothing at all -- deliberately. A form posting to
# a nonexistent newsletter collects addresses into a 404 while telling people
# they subscribed, which is worse than having no form.
#
# NEXT_PUBLIC_ because the site is a static export with no server: the value is
# inlined into the bundle at build time and the browser posts straight to
# Buttondown. Do not put an API key here -- this endpoint needs none, and
# anything NEXT_PUBLIC_ is readable by anyone who views source.
NEXT_PUBLIC_BUTTONDOWN_USER=

# Canonical origin, used for metadataBase, OG image URLs, sitemap and the feed.
# Absolute URLs are required for OG cards: relative ones will not resolve when
# a link is unfurled by Slack, iMessage or X.
NEXT_PUBLIC_SITE_URL=https://cremeandmisu.com
