{
  "name": "personal-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-output/tests/*.js",
    "test:e2e": "npm run build && node --test tests/static-export.test.mjs",
    "lint": "next lint",
    "serve": "npx --yes serve out",
    "deploy:s3": "./deploy-to-s3.sh",
    "deploy:gh-pages": "rm -rf out && npm run build && cd out && touch .nojekyll && git init && git add . && git commit -m \"Deploy to GitHub Pages\" && git branch -M gh-pages && git push -f origin gh-pages"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "next": "15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.0",
    "typescript": "^5"
  }
}
